# Neon Postgres connection string (https://neon.tech -> project -> Connection string)
# Looks like: postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/DBNAME?sslmode=require
DATABASE_URL=

# Secret for signing session + password-reset tokens.
# REQUIRED in production (the app refuses to start without it). Use a long random
# value, e.g. generate with:  openssl rand -base64 32
AUTH_SECRET=

# Secret Vercel sends to authenticated cron routes. Required in production.
CRON_SECRET=

# Email delivery for password reset (optional; without it, reset links are logged to the server console)
RESEND_API_KEY=
EMAIL_FROM=StateStreet Ops <onboarding@resend.dev>
