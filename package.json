{
  "name": "statestreet-ops",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "dev:local": "agent-secret run AUTH_SECRET statestreet.local.auth_secret -- node scripts/run-local.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings=0",
    "lint:fix": "eslint --fix",
    "verify": "node scripts/verify.mjs",
    "verify:fast": "node scripts/verify.mjs fast",
    "verify:db": "node scripts/verify.mjs db",
    "verify:all": "node scripts/verify.mjs all",
    "test": "vitest run",
    "test:db": "vitest run src/lib/*.integration.test.ts src/lib/reporting/*.integration.test.ts src/lib/export.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:plan-backfill": "node scripts/plan-foundation-backfill.mjs",
    "db:backfill:daily": "node scripts/backfill-daily-reports.mjs",
    "db:seed:foundation": "node scripts/seed-foundation-catalog.mjs",
    "db:seed:foundation:apply": "node scripts/seed-foundation-catalog.mjs --apply",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:local:setup": "node scripts/local-db.mjs setup",
    "db:local:reset": "node scripts/local-db.mjs reset",
    "db:local:seed": "node scripts/seed-local.mjs",
    "db:local:fresh": "npm run db:local:reset && npm run db:local:seed",
    "db:local:status": "node scripts/local-db.mjs status",
    "db:seed": "node scripts/seed-users.mjs",
    "db:seed:all": "npm run db:seed && node scripts/seed-all.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "exceljs": "^4.4.0",
    "lucide-react": "^1.17.0",
    "next": "16.2.7",
    "next-themes": "^0.4.6",
    "pg": "^8.22.0",
    "radix-ui": "^1.6.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.9.2",
    "shadcn": "^4.13.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.7",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "3.2.7"
  }
}
