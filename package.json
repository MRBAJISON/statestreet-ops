{
  "name": "statestreet-ops",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings=0",
    "lint:fix": "eslint --fix",
    "verify": "node scripts/verify.mjs",
    "verify:fast": "node scripts/verify.mjs fast",
    "verify:db": "node scripts/verify.mjs db",
    "verify:all": "node scripts/verify.mjs all",
