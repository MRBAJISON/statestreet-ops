    "db:seed:all": "npm run db:seed && node scripts/seed-all.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
