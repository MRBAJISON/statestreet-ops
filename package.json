    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:plan-backfill": "node scripts/plan-foundation-backfill.mjs",
    "db:seed:foundation": "node scripts/seed-foundation-catalog.mjs",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
